---
import { ArrowRight, Mail, MapPin, MessageCircle, Clock } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business, whatsappUrl } from '@/content/site';
---

<BaseLayout
  seo={{
    title: 'Contacto Rosario Contable en Santiago',
    description:
      'Contacta a Rosario Contable en Santiago para evaluación contable y financiera, apoyo en impuestos, flujo de caja, cuentas por cobrar y pagar e informes financieros.',
    path: '/contact'
  }}
>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-medium uppercase tracking-wide text-sage-700">Contacto directo</p>
      <h1 class="font-display mt-4 text-4xl font-extrabold tracking-normal text-navy-900 sm:text-5xl">Cuéntame qué te está complicando.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Puede ser impuestos, pagos, cobranza, costos o simplemente la sensación de no tener claridad. Partimos desde ahí.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="whatsapp-motion group rounded-lg border border-navy-800 bg-navy-900 p-6 text-white no-underline shadow-soft" data-reveal>
          <MessageCircle size={26} aria-hidden="true" />
          <h2 class="font-display mt-4 text-2xl font-bold">Consultar por WhatsApp</h2>
          <p class="mt-2 text-navy-100">{business.phone || 'Consultar por WhatsApp'}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-copper-100">
            Abrir WhatsApp
            <ArrowRight class="transition duration-300 group-hover:translate-x-1" size={16} aria-hidden="true" />
          </span>
        </a>
        <a href={`mailto:${business.email}`} class="contact-card-motion group rounded-lg border border-navy-200 bg-navy-50 p-6 text-navy-900 no-underline shadow-sm ring-1 ring-navy-100" data-reveal style="--reveal-delay: 80ms">
          <Mail class="text-navy-700" size={26} aria-hidden="true" />
          <h2 class="font-display mt-4 text-2xl font-bold">Correo</h2>
          <p class="mt-2 text-slate-600">{business.email}</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-navy-800">
            Enviar correo
            <ArrowRight class="transition duration-300 group-hover:translate-x-1" size={16} aria-hidden="true" />
          </span>
        </a>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm" data-reveal style="--reveal-delay: 160ms">
          <MapPin class="text-sage-600" size={26} aria-hidden="true" />
          <h2 class="font-display mt-4 text-2xl font-bold text-navy-900">Ubicación</h2>
          <p class="mt-2 text-slate-600">{business.address}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm" data-reveal style="--reveal-delay: 240ms">
          <Clock class="text-sage-600" size={26} aria-hidden="true" />
          <h2 class="font-display mt-4 text-2xl font-bold text-navy-900">Horario</h2>
          <p class="mt-2 text-slate-600">{business.hours}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
