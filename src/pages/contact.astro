---
import { Mail, MapPin, MessageCircle, Clock } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { business, whatsappUrl } from '@/content/site';
---

<BaseLayout
  seo={{
    title: 'Contacta a una contadora en Santiago',
    description:
      'Contacta por WhatsApp o email a una contadora independiente en Santiago para servicios contables, declaración de impuestos en Chile, remuneraciones y asesoría.',
    path: '/contact'
  }}
>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Contacto</p>
      <h1 class="mt-4 text-4xl font-bold tracking-normal text-navy-900 sm:text-5xl">Cuéntame qué apoyo contable necesitas.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Para cotizar más rápido, incluye el giro de tu negocio, volumen mensual de documentos, si tienes trabajadores y tu vencimiento principal.</p>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-slate-200 bg-sage-600 p-6 text-white no-underline shadow-sm">
          <MessageCircle size={26} aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-bold">WhatsApp</h2>
          <p class="mt-2">{business.phone}</p>
        </a>
        <a href={`mailto:${business.email}`} class="rounded-lg border border-slate-200 bg-white p-6 text-navy-900 no-underline shadow-sm">
          <Mail size={26} aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-bold">Correo</h2>
          <p class="mt-2 text-slate-600">{business.email}</p>
        </a>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
          <MapPin class="text-sage-600" size={26} aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-bold text-navy-900">Ubicación</h2>
          <p class="mt-2 text-slate-600">{business.address}</p>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
          <Clock class="text-sage-600" size={26} aria-hidden="true" />
          <h2 class="mt-4 text-2xl font-bold text-navy-900">Horario</h2>
          <p class="mt-2 text-slate-600">{business.hours}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
