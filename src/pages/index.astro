---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { differentiators, services } from '@/content/site';

const diagnosticAreas = ['Compras', 'Ventas', 'Cobranza', 'Pagos', 'Costos', 'Flujo de caja', 'Rentabilidad'];

const processSteps = [
  {
    number: '01',
    title: 'Evaluación inicial',
    description: 'Se revisa la situación contable, administrativa y financiera del negocio.'
  },
  {
    number: '02',
    title: 'Puntos críticos',
    description: 'Se identifican desordenes, fugas de costos y oportunidades de mejora.'
  },
  {
    number: '03',
    title: 'Plan de acción',
    description: 'Recibes prioridades concretas, seguimiento e informes para gestionar mejor.'
  }
];
---

<BaseLayout
  seo={{
    title: 'Apoyo contable y financiero para MIPYMES',
    description:
      'Apoyo contable, administrativo y financiero para personas naturales, pymes y MIPYMES: impuestos, flujo de caja, cuentas por cobrar y pagar, informes financieros y diagnóstico inicial.',
    path: '/'
  }}
>
  <Hero />

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Servicios</p>
        <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Servicios para ordenar, controlar y decidir mejor</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service, index) => <ServiceCard {...service} delay={index * 70} />)}
      </div>
    </div>
  </section>

  <section class="bg-navy-900">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-[0.9fr_1.1fr] md:items-center lg:px-8">
      <div data-reveal="left">
        <p class="text-sm font-semibold uppercase tracking-wide text-copper-100">Diagnóstico inicial</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-white sm:text-4xl">Detectar puntos débiles antes de proponer mejoras</h2>
        <p class="mt-5 leading-8 text-navy-100">
          Una revisión clara para saber dónde se pierde control, dinero o tiempo dentro de la empresa.
        </p>
      </div>
      <div class="grid gap-5" data-reveal="right" style="--reveal-delay: 120ms">
        <div class="flex flex-wrap gap-3">
          {diagnosticAreas.map((area, index) => (
            <span class="rounded-full border border-navy-700 bg-navy-800 px-4 py-2 text-sm font-semibold text-navy-50 transition duration-300 hover:-translate-y-0.5 hover:border-copper-100" data-reveal style={`--reveal-delay: ${index * 45}ms`}>{area}</span>
          ))}
        </div>
        <p class="leading-8 text-navy-100">
          Con ese diagnóstico se proponen acciones concretas para ordenar procesos administrativos, optimizar costos y fortalecer los resultados del negocio.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Cómo trabajamos</p>
        <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Un proceso simple para pasar del desorden a la acción</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {processSteps.map((step, index) => (
          <article class="rounded-lg border border-slate-200 bg-slate-50 p-6 transition duration-300 hover:-translate-y-1 hover:shadow-soft" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <p class="text-sm font-bold text-copper-600">{step.number}</p>
            <h3 class="mt-4 text-xl font-bold text-navy-900">{step.title}</h3>
            <p class="mt-3 leading-7 text-slate-600">{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Por qué elegir este servicio</p>
        <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Acompañamiento claro, personalizado y orientado a resultados</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {differentiators.map((item, index) => (
          <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-copper-100 hover:shadow-soft" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <h3 class="text-lg font-bold text-navy-900">{item.title}</h3>
            <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FAQAccordion />
  <FinalCTA />
</BaseLayout>
