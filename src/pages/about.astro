---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import aboutImage from '@/assets/sobre-mi.jpg';
---

<BaseLayout
  seo={{
    title: 'Sobre Rosario Trincado',
    description:
      'Rosario Trincado cuenta con más de 40 años de experiencia en apoyo contable, administración y gestión financiera para personas naturales, pymes y MIPYMES.',
    path: '/about'
  }}
>
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[0.9fr_1.1fr] md:items-center lg:px-8">
      <img src={aboutImage.src} alt="Retrato profesional de Rosario Trincado" class="w-full rounded-lg border border-slate-200 bg-slate-100 object-cover shadow-sm" />
      <div class="max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-wide text-sage-700">Sobre Rosario</p>
        <h1 class="font-display mt-4 text-4xl font-extrabold tracking-normal text-navy-900 sm:text-5xl">Más de 40 años ayudando a ordenar números, procesos y decisiones.</h1>
        <p class="mt-6 text-justify leading-8 text-slate-600">Rosario Trincado apoya a personas naturales, pymes y MIPYMES que necesitan ordenar su administración, controlar costos, revisar rentabilidad y tener información clara sobre el estado real del negocio.</p>
        <p class="mt-4 text-justify leading-8 text-slate-600">Su trayectoria en áreas de administración y contabilidad permite detectar oportunidades de mejora, optimizar procesos y transformar la información financiera en acciones concretas.</p>
        <p class="mt-4 text-justify leading-8 text-slate-600">La atención es personalizada, híbrida y presencial, con valores competitivos y una evaluación inicial para identificar los principales puntos débiles de la empresa.</p>
      </div>
    </div>
  </section>
  <FinalCTA />
</BaseLayout>
