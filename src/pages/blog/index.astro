---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts } from '@/lib/sanity';

const posts = await getPosts();
---

<BaseLayout
  seo={{
    title: 'Blog contable para emprendedores en Chile',
    description:
      'Artículos prácticos sobre servicios contables en Chile, declaración de impuestos, constitución de empresa y cumplimiento mensual para pymes.',
    path: '/blog'
  }}
>
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Blog</p>
      <h1 class="mt-4 text-4xl font-bold tracking-normal text-navy-900 sm:text-5xl">Orientación contable para dueños de negocio</h1>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <article class="rounded-lg border border-slate-200 bg-slate-50 p-6">
            <p class="text-sm text-slate-500">{new Date(post.publishedAt).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <h2 class="mt-3 text-2xl font-bold text-navy-900">
              <a class="text-navy-900 no-underline hover:text-sage-700" href={`/blog/${post.slug}`}>{post.title}</a>
            </h2>
            <p class="mt-3 leading-7 text-slate-600">{post.excerpt}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
