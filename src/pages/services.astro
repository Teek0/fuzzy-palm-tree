---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import { services } from '@/content/site';
---

<BaseLayout
  seo={{
    title: 'Servicios contables en Chile',
    description:
      'Constitución de empresa, declaración de impuestos en Chile, contabilidad mensual, facturación, boletas, remuneraciones y asesoría tributaria para pymes.',
    path: '/services'
  }}
>
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Servicios</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-normal text-navy-900 sm:text-5xl">Servicios contables para pequeñas empresas en Chile</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">Elige apoyo contable enfocado en tu etapa actual: iniciar una empresa, ordenar obligaciones tributarias pendientes o mantener el cumplimiento mensual bajo control.</p>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
    </div>
  </section>
  <FinalCTA />
</BaseLayout>
