---
import { testimonials } from '@/content/site';
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Testimonios</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Confianza de negocios locales</h2>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {testimonials.map((item) => (
        <figure class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <blockquote class="leading-7 text-slate-700">“{item.quote}”</blockquote>
          <figcaption class="mt-5">
            <p class="font-semibold text-navy-900">{item.name}</p>
            <p class="text-sm text-slate-500">{item.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
