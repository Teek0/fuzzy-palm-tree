---
import { ArrowRight, MessageCircle } from '@lucide/astro';
import { whatsappUrl } from '@/content/site';
---

<section class="bg-navy-900">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-[1fr_auto] md:items-center lg:px-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-copper-100">Evaluación inicial</p>
      <h2 class="mt-3 max-w-3xl text-3xl font-bold tracking-normal text-white sm:text-4xl">
        ¿Necesitas ordenar la administración y finanzas de tu negocio?
      </h2>
      <p class="mt-4 max-w-2xl leading-7 text-navy-100">
        Envía el giro de tu negocio, tamaño del equipo y el área que quieres revisar primero.
      </p>
    </div>
    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 rounded-lg bg-sage-600 px-5 py-3 font-semibold text-white no-underline hover:bg-sage-700"
    >
      <MessageCircle size={20} aria-hidden="true" />
      Contactar por WhatsApp
      <ArrowRight size={18} aria-hidden="true" />
    </a>
  </div>
</section>
