---
import { MessageCircle } from '@lucide/astro';
import { whatsappUrl } from '@/content/site';
---

<section class="bg-navy-900">
  <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold tracking-normal text-white sm:text-4xl">¿Necesitas ordenar la administración y finanzas de tu negocio?</h2>
    <p class="mx-auto mt-4 max-w-2xl leading-7 text-navy-100">
      Envía un mensaje con el giro de tu negocio, tamaño del equipo y el área que quieres revisar primero.
    </p>
    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-sage-600 px-5 py-3 font-semibold text-white no-underline hover:bg-sage-700"
    >
      <MessageCircle size={20} aria-hidden="true" />
      Contactar por WhatsApp
    </a>
  </div>
</section>
