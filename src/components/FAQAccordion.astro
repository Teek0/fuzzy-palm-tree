---
import { ChevronDown } from '@lucide/astro';
import { faqs } from '@/content/site';
---

<section class="bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">FAQ</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Preguntas frecuentes</h2>
    </div>
    <div class="mt-10 grid gap-4">
      {faqs.map((item, index) => (
        <article class="faq-item rounded-lg border border-slate-200 bg-white shadow-sm transition hover:border-copper-100 hover:shadow-soft" data-open="false">
          <h3>
            <button
              type="button"
              class="faq-trigger flex w-full items-center justify-between gap-4 px-5 py-5 text-left text-lg font-semibold text-navy-900"
              aria-expanded="false"
              aria-controls={`faq-panel-${index}`}
            >
              <span>{item.question}</span>
              <ChevronDown class="faq-icon shrink-0 text-sage-600 transition-transform duration-200" size={22} aria-hidden="true" />
            </button>
          </h3>
          <div id={`faq-panel-${index}`} class="faq-panel grid opacity-0 transition-all duration-200 ease-out">
            <div class="overflow-hidden">
              <p class="px-5 pb-5 leading-7 text-slate-600">{item.answer}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-panel {
    grid-template-rows: 0fr;
  }

  .faq-item[data-open='true'] .faq-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .faq-item[data-open='true'] .faq-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.faq-item').forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');

    trigger?.addEventListener('click', () => {
      const isOpen = item.dataset.open === 'true';
      item.dataset.open = String(!isOpen);
      trigger.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
