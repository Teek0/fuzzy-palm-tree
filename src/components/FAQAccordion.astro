---
import { faqs } from '@/content/site';
---

<section class="bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">FAQ</p>
      <h2 class="mt-3 text-3xl font-bold text-navy-900 sm:text-4xl">Preguntas frecuentes</h2>
    </div>
    <div class="mt-10 grid gap-4">
      {faqs.map((item) => (
        <details class="rounded-lg border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer text-lg font-semibold text-navy-900">{item.question}</summary>
          <p class="mt-4 leading-7 text-slate-600">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
