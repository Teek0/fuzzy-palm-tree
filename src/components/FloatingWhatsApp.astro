---
import { Mail } from '@lucide/astro';
import { whatsappUrl } from '@/content/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsapp-float fixed bottom-5 right-5 z-50 grid h-14 w-14 place-items-center rounded-full bg-sage-600 text-white shadow-soft transition duration-300 hover:scale-105 hover:bg-sage-700"
  aria-label="Contactar a Rosario Contable"
>
  <Mail size={26} aria-hidden="true" />
</a>

<style>
  .whatsapp-float {
    animation: whatsapp-enter 420ms ease both, whatsapp-pulse 4.5s ease-in-out 1.4s infinite;
  }

  @keyframes whatsapp-enter {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes whatsapp-pulse {
    0%,
    72%,
    100% {
      box-shadow: 0 18px 45px rgba(13, 41, 65, 0.09);
      transform: scale(1);
    }
    82% {
      box-shadow: 0 18px 45px rgba(67, 120, 87, 0.28);
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      animation: none;
    }
  }
</style>
