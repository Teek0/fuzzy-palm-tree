---
import { Calculator, Menu } from '@lucide/astro';
import { business, navItems, whatsappUrl } from '@/content/site';
---

<header class="sticky top-0 z-40 border-b border-navy-800 bg-navy-900 shadow-soft">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Navegación principal">
    <a href="/" class="flex items-center gap-3 text-white no-underline" aria-label={`Inicio de ${business.name}`}>
      <span class="grid h-10 w-10 place-items-center rounded-lg bg-white text-navy-900">
        <Calculator size={22} aria-hidden="true" />
      </span>
      <span class="text-base font-bold tracking-normal">{business.name}</span>
    </a>
    <div class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a class="text-sm font-medium text-navy-100 no-underline hover:text-white" href={item.href}>{item.label}</a>
      ))}
      <a
        class="rounded-lg bg-sage-500 px-4 py-2.5 text-sm font-semibold text-white no-underline hover:bg-sage-600"
        href={whatsappUrl()}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>
    </div>
    <details class="relative md:hidden">
      <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-lg border border-navy-700 text-white">
        <Menu size={22} aria-hidden="true" />
        <span class="sr-only">Abrir menú</span>
      </summary>
      <div class="absolute right-0 mt-3 w-56 rounded-lg border border-navy-800 bg-navy-900 p-3 shadow-soft">
        {navItems.map((item) => (
          <a class="block rounded-md px-3 py-2 text-sm font-medium text-navy-100 no-underline hover:bg-navy-800 hover:text-white" href={item.href}>{item.label}</a>
        ))}
        <a class="mt-2 block rounded-md bg-sage-500 px-3 py-2 text-sm font-semibold text-white no-underline hover:bg-sage-600" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      </div>
    </details>
  </nav>
</header>
