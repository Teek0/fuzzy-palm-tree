---
import { Building2, ChartNoAxesCombined, ClipboardCheck } from '@lucide/astro';
import aboutImage from '@/assets/sobre-mi.jpg';

const strengths = [
  { icon: Building2, label: 'Administración' },
  { icon: ClipboardCheck, label: 'Contabilidad' },
  { icon: ChartNoAxesCombined, label: 'Resultados' }
];
---

<section class="bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[0.85fr_1.15fr] md:items-center lg:px-8">
    <div data-reveal="left">
      <img src={aboutImage.src} alt="Retrato profesional de Rosario Trincado" class="w-full rounded-lg border border-slate-200 bg-slate-100 object-cover shadow-sm" loading="lazy" />
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {strengths.map(({ icon: Icon, label }, index) => (
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 transition duration-300 hover:-translate-y-1 hover:border-copper-100 hover:shadow-sm" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
            <Icon class="text-sage-600" size={22} aria-hidden="true" />
            <p class="mt-3 text-sm font-semibold text-navy-900">{label}</p>
          </div>
        ))}
      </div>
    </div>
    <div class="max-w-2xl" data-reveal="right" style="--reveal-delay: 120ms">
      <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Sobre el servicio</p>
      <h2 class="mt-3 text-3xl font-bold tracking-normal text-navy-900 sm:text-4xl">Experiencia en administración, contabilidad y mejora de procesos.</h2>
      <p class="mt-5 text-justify leading-8 text-slate-600">
        El apoyo está pensado para dueños de negocio que necesitan claridad real sobre flujo de caja, costos, rentabilidad, compras, ventas y obligaciones tributarias.
      </p>
      <p class="mt-4 text-justify leading-8 text-slate-600">
        La atención es personalizada, con modalidad híbrida y presencial, para revisar la situación de cada cliente y proponer acciones concretas.
      </p>
      <a href="/about" class="mt-6 inline-flex rounded-lg border border-navy-200 px-4 py-2.5 font-semibold text-navy-900 no-underline hover:bg-navy-50">Conocer más</a>
    </div>
  </div>
</section>
